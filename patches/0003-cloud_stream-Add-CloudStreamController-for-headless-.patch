+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/cloud_stream/cloud_select_file_dialog.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "chrome/browser/cloud_stream/cloud_stream_controller.h"
+#include "ui/shell_dialogs/select_file_policy.h"
+#include "ui/shell_dialogs/selected_file_info.h"
+
+namespace cloud_stream {
+
+namespace {
+
+FileChooserMode ModeForType(ui::SelectFileDialog::Type type) {
+  switch (type) {
+    case ui::SelectFileDialog::SELECT_FOLDER:
+    case ui::SelectFileDialog::SELECT_UPLOAD_FOLDER:
+    case ui::SelectFileDialog::SELECT_EXISTING_FOLDER:
+      return FileChooserMode::kFolder;
+    case ui::SelectFileDialog::SELECT_SAVEAS_FILE:
+      return FileChooserMode::kSave;
+    case ui::SelectFileDialog::SELECT_OPEN_MULTI_FILE:
+      return FileChooserMode::kOpenMultiple;
+    case ui::SelectFileDialog::SELECT_NONE:
+    case ui::SelectFileDialog::SELECT_OPEN_FILE:
+      return FileChooserMode::kOpen;
+  }
+  return FileChooserMode::kOpen;
+}
+
+}  // namespace
+
+CloudSelectFileDialog::CloudSelectFileDialog(
+    Listener* listener,
+    std::unique_ptr<ui::SelectFilePolicy> policy)
+    : ui::SelectFileDialog(listener, std::move(policy)) {}
+
+CloudSelectFileDialog::~CloudSelectFileDialog() = default;
+
+bool CloudSelectFileDialog::IsRunning(gfx::NativeWindow owning_window) const {
+  return running_;
+}
+
+void CloudSelectFileDialog::ListenerDestroyed() {
+  listener_ = nullptr;
+}
+
+bool CloudSelectFileDialog::HasMultipleFileTypeChoicesImpl() {
+  return false;
+}
+
+void CloudSelectFileDialog::SelectFileImpl(
+    Type type,
+    const std::u16string& title,
+    const base::FilePath& default_path,
+    const FileTypeInfo* file_types,
+    int file_type_index,
+    const base::FilePath::StringType& default_extension,
+    gfx::NativeWindow owning_window,
+    const GURL* caller) {
+  CloudStreamController* controller = CloudStreamController::Get();
+  if (!controller) {
+    if (listener_) {
+      listener_->FileSelectionCanceled();
+    }
+    return;
+  }
+  type_ = type;
+  running_ = true;
+  // Keep `this` alive until the gateway answers.
+  controller->RequestFileChooser(
+      owning_window, ModeForType(type), title,
+      base::BindOnce(&CloudSelectFileDialog::OnResult,
+                     scoped_refptr<CloudSelectFileDialog>(this)));
+}
+
+void CloudSelectFileDialog::OnResult(bool canceled,
+                                     std::vector<base::FilePath> paths) {
+  running_ = false;
+  if (!listener_) {
+    return;
+  }
+  if (canceled || paths.empty()) {
+    listener_->FileSelectionCanceled();
+    return;
+  }
+  if (type_ == SELECT_OPEN_MULTI_FILE) {
+    std::vector<ui::SelectedFileInfo> files;
+    for (const auto& path : paths) {
+      files.emplace_back(path);
+    }
+    listener_->MultiFilesSelected(files);
+    return;
+  }
+  listener_->FileSelected(ui::SelectedFileInfo(paths.front()), /*index=*/0);
+}
+
+ui::SelectFileDialog* CloudSelectFileDialogFactory::Create(
+    ui::SelectFileDialog::Listener* listener,
+    std::unique_ptr<ui::SelectFilePolicy> policy) {
+  return new CloudSelectFileDialog(listener, std::move(policy));
+}
+
+}  // namespace cloud_stream
