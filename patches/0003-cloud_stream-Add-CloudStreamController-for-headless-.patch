+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_CLOUD_STREAM_WINDOW_STREAM_H_
+#define CHROME_BROWSER_CLOUD_STREAM_WINDOW_STREAM_H_
+
+#include <map>
+#include <memory>
+
+#include "base/memory/raw_ptr.h"
+#include "base/time/time.h"
+#include "components/viz/host/client_frame_sink_video_capturer.h"
+#include "mojo/public/cpp/bindings/remote.h"
+#include "services/viz/privileged/mojom/compositing/frame_sink_video_capture.mojom.h"
+#include "ui/aura/window_tree_host_observer.h"
+#include "ui/gfx/geometry/rect.h"
+
+namespace aura {
+class WindowTreeHost;
+}  // namespace aura
+
+namespace cloud_stream {
+
+class PipeTransport;
+
+// Streams one top-level aura window (browser window, menu, bubble, popup) to
+// the gateway. Owns a FrameSinkVideoCapturer targeting the root frame sink of
+// the host's ui::Compositor, the same way AuraWindowVideoCaptureDevice does,
+// and forwards each captured D3D11 texture to the gateway by NT handle.
+class WindowStream : public viz::mojom::FrameSinkVideoConsumer,
+                     public aura::WindowTreeHostObserver {
+ public:
+  WindowStream(uint32_t window_id,
+               aura::WindowTreeHost* host,
+               PipeTransport* transport,
+               HANDLE gateway_process,
+               base::TimeDelta min_capture_period);
+  WindowStream(const WindowStream&) = delete;
+  WindowStream& operator=(const WindowStream&) = delete;
+  ~WindowStream() override;
+
+  uint32_t window_id() const { return window_id_; }
+  aura::WindowTreeHost* host() const { return host_; }
+
+  // Gateway finished with `frame_seq`; returns the buffer to the capturer.
+  void OnFrameDone(uint64_t frame_seq);
+
+  // Asks the capturer for a frame even if nothing changed (e.g. a new client
+  // joined and needs a key frame).
+  void RequestRefreshFrame();
+
+ private:
+  // viz::mojom::FrameSinkVideoConsumer:
+  void OnFrameCaptured(
+      media::mojom::VideoBufferHandlePtr data,
+      media::mojom::VideoFrameInfoPtr info,
+      const gfx::Rect& content_rect,
+      mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+          callbacks) override;
+  void OnNewCaptureVersion(
+      const media::CaptureVersion& capture_version) override {}
+  void OnFrameWithEmptyRegionCapture() override {}
+  void OnStopped() override {}
+  void OnLog(const std::string& message) override {}
+
+  // aura::WindowTreeHostObserver:
+  void OnHostResized(aura::WindowTreeHost* host) override;
+  void OnHostMovedInPixels(aura::WindowTreeHost* host) override;
+
+  void UpdateResolution();
+  void SendBounds();
+
+  const uint32_t window_id_;
+  const raw_ptr<aura::WindowTreeHost> host_;
+  const raw_ptr<PipeTransport> transport_;
+  // Owned by the controller; used as DuplicateHandle target.
+  const HANDLE gateway_process_;
+
+  std::unique_ptr<viz::ClientFrameSinkVideoCapturer> capturer_;
+
+  uint64_t next_frame_seq_ = 1;
+  // Frames handed to the gateway and not yet released.
+  std::map<uint64_t,
+           mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>>
+      in_flight_;
+  // Tokens of textures the gateway already has a handle for. The capturer
+  // reuses a small pool, so each texture is duplicated only once.
+  std::map<std::pair<uint64_t, uint64_t>, bool> known_tokens_;
+};
+
+}  // namespace cloud_stream
+
+#endif  // CHROME_BROWSER_CLOUD_STREAM_WINDOW_STREAM_H_
