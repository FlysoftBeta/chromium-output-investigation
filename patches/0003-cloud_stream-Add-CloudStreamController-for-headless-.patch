+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_CLOUD_STREAM_CLOUD_STREAM_CONTROLLER_H_
+#define CHROME_BROWSER_CLOUD_STREAM_CLOUD_STREAM_CONTROLLER_H_
+
+#include <map>
+#include <memory>
+#include <string>
+#include <vector>
+
+#include "base/files/file_path.h"
+#include "base/functional/callback.h"
+#include "base/memory/raw_ptr.h"
+#include "base/memory/weak_ptr.h"
+#include "base/time/time.h"
+#include "base/win/scoped_handle.h"
+#include "chrome/browser/cloud_stream/public/cloud_stream_protocol.h"
+#include "ui/aura/env_observer.h"
+#include "ui/gfx/native_ui_types.h"
+#include "ui/views/widget/desktop_aura/cloud_stream_hooks_win.h"
+
+namespace aura {
+class WindowTreeHost;
+}  // namespace aura
+
+namespace cloud_stream {
+
+class PipeTransport;
+class WindowStream;
+
+// Browser-process side of cloud streaming mode (--cloud-stream-pipe).
+//
+//  * Tracks every top-level aura::WindowTreeHost (browser windows, menus,
+//    bubbles, popups) and announces them to the gateway.
+//  * Owns one WindowStream (frame capture) per host once the gateway said
+//    hello.
+//  * Implements the views hooks: external BeginFrame, cursor, drag and drop.
+//  * Serves remote file chooser requests for CloudSelectFileDialog.
+//
+// Lives on the UI thread. Created in
+// ChromeBrowserMainExtraPartsHeadless::PreBrowserStart().
+class CloudStreamController : public aura::EnvObserver,
+                              public views::CloudStreamHooksWin {
+ public:
+  using FileChooserCallback =
+      base::OnceCallback<void(bool canceled, std::vector<base::FilePath>)>;
+
+  // Returns nullptr unless running in cloud streaming mode.
+  static CloudStreamController* Get();
+
+  // Creates and starts the controller if --cloud-stream-pipe is present.
+  static std::unique_ptr<CloudStreamController> MaybeCreate();
+
+  CloudStreamController(const CloudStreamController&) = delete;
+  CloudStreamController& operator=(const CloudStreamController&) = delete;
+  ~CloudStreamController() override;
+
+  // Called by CloudSelectFileDialog.
+  void RequestFileChooser(gfx::NativeWindow owning_window,
+                          FileChooserMode mode,
+                          const std::u16string& title,
+                          FileChooserCallback callback);
+
+ private:
+  explicit CloudStreamController(const std::wstring& pipe_name);
+  bool Start();
+
+  // aura::EnvObserver:
+  void OnHostInitialized(aura::WindowTreeHost* host) override;
+  void OnHostDestroyed(aura::WindowTreeHost* host) override;
+
+  // views::CloudStreamHooksWin:
+  bool UseExternalBeginFrameControl() override;
+  void OnCursorChanged(aura::WindowTreeHost* host,
+                       const ui::Cursor& cursor) override;
+  std::unique_ptr<aura::client::DragDropClient> CreateDragDropClient(
+      aura::WindowTreeHost* host) override;
+
+  // Transport.
+  void OnMessage(MessageType type, std::vector<uint8_t> payload);
+  void OnDisconnected();
+
+  // Message handlers.
+  void HandleHello(const HelloMessage& msg);
+  void HandleBeginFrame(const BeginFrameMessage& msg);
+  void HandleFrameDone(const FrameDoneMessage& msg);
+  void HandleSetWindowBounds(const WindowBoundsMessage& msg);
+  void HandleFileChosen(const FileChosenMessage& msg,
+                        const std::u16string& paths);
+
+  void AnnounceWindow(uint32_t id, aura::WindowTreeHost* host);
+  void StartStream(uint32_t id, aura::WindowTreeHost* host);
+  aura::WindowTreeHost* HostForId(uint32_t id) const;
+  uint32_t IdForHost(aura::WindowTreeHost* host) const;
+
+  const std::wstring pipe_name_;
+  std::unique_ptr<PipeTransport> transport_;
+
+  // Set after kHello. Frame handles are duplicated into this process.
+  base::win::ScopedHandle gateway_process_;
+  bool hello_received_ = false;
+
+  uint32_t next_window_id_ = 1;
+  std::map<uint32_t, raw_ptr<aura::WindowTreeHost>> hosts_;
+  std::map<uint32_t, std::unique_ptr<WindowStream>> streams_;
+
+  uint64_t begin_frame_sequence_;
+
+  uint32_t next_file_request_id_ = 1;
+  std::map<uint32_t, FileChooserCallback> file_requests_;
+
+  base::WeakPtrFactory<CloudStreamController> weak_factory_{this};
+};
+
+}  // namespace cloud_stream
+
+#endif  // CHROME_BROWSER_CLOUD_STREAM_CLOUD_STREAM_CONTROLLER_H_
diff --git a/chrome/browser/cloud_stream/pipe_transport.cc b/chrome/browser/cloud_stream/pipe_transport.cc
new file mode 100644
index 00000000..03fa4c8b
--- /dev/null
+++ b/chrome/browser/cloud_stream/pipe_transport.cc
@@ -0,0 +1,127 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/cloud_stream/pipe_transport.h"
+
+#include <windows.h>
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/logging.h"
+#include "base/task/sequenced_task_runner.h"
+
+namespace cloud_stream {
+
+namespace {
+
+// Upper bound for a single payload, to reject a corrupt stream early.
+constexpr uint32_t kMaxPayloadSize = 16 * 1024 * 1024;
+
+bool ReadAll(HANDLE pipe, void* data, uint32_t size) {
+  auto* p = static_cast<uint8_t*>(data);
+  while (size > 0) {
+    DWORD read = 0;
+    if (!::ReadFile(pipe, p, size, &read, nullptr) || read == 0) {
+      return false;
+    }
+    p += read;
+    size -= read;
+  }
+  return true;
+}
+
+}  // namespace
+
+PipeTransport::PipeTransport(const std::wstring& pipe_name,
+                             MessageCallback on_message,
+                             base::OnceClosure on_disconnected)
+    : pipe_name_(pipe_name),
+      on_message_(std::move(on_message)),
+      on_disconnected_(std::move(on_disconnected)),
+      ui_task_runner_(base::SequencedTaskRunner::GetCurrentDefault()),
+      read_thread_("CloudStreamPipeRead") {}
+
+PipeTransport::~PipeTransport() {
+  // Closing the handle unblocks ReadFile on the read thread.
+  pipe_.Close();
+  read_thread_.Stop();
+}
+
+bool PipeTransport::Start() {
+  const std::wstring path = L"\\\\.\\pipe\\" + pipe_name_;
+  pipe_.Set(::CreateFileW(path.c_str(), GENERIC_READ | GENERIC_WRITE, 0,
+                          nullptr, OPEN_EXISTING, 0, nullptr));
+  if (!pipe_.is_valid()) {
+    PLOG(ERROR) << "cloud_stream: cannot open pipe";
+    return false;
+  }
+  DWORD mode = PIPE_READMODE_BYTE;
+  ::SetNamedPipeHandleState(pipe_.get(), &mode, nullptr, nullptr);
+
+  if (!read_thread_.Start()) {
+    return false;
+  }
+  read_thread_.task_runner()->PostTask(
+      FROM_HERE,
+      base::BindOnce(&PipeTransport::ReadLoop, base::Unretained(this)));
+  return true;
+}
+
+void PipeTransport::ReadLoop() {
+  for (;;) {
+    MessageHeader header;
+    if (!ReadAll(pipe_.get(), &header, sizeof(header)) ||
+        header.payload_size > kMaxPayloadSize) {
+      break;
+    }
+    std::vector<uint8_t> payload(header.payload_size);
+    if (header.payload_size &&
+        !ReadAll(pipe_.get(), payload.data(), header.payload_size)) {
+      break;
+    }
+    ui_task_runner_->PostTask(
+        FROM_HERE, base::BindOnce(on_message_, header.type, std::move(payload)));
+  }
+  if (on_disconnected_) {
+    ui_task_runner_->PostTask(FROM_HERE, std::move(on_disconnected_));
+  }
+}
+
+bool PipeTransport::WriteAll(const void* data, uint32_t size) {
+  auto* p = static_cast<const uint8_t*>(data);
+  while (size > 0) {
+    DWORD written = 0;
+    if (!::WriteFile(pipe_.get(), p, size, &written, nullptr) ||
+        written == 0) {
+      return false;
+    }
+    p += written;
+    size -= written;
+  }
+  return true;
+}
+
+bool PipeTransport::Send(MessageType type,
+                         const void* payload,
+                         uint32_t payload_size) {
+  return Send(type, payload, payload_size, nullptr, 0);
+}
+
+bool PipeTransport::Send(MessageType type,
+                         const void* payload,
+                         uint32_t payload_size,
+                         const void* tail,
+                         uint32_t tail_size) {
+  base::AutoLock lock(write_lock_);
+  if (!pipe_.is_valid()) {
+    return false;
+  }
+  MessageHeader header{type, payload_size + tail_size};
+  return WriteAll(&header, sizeof(header)) &&
+         (!payload_size || WriteAll(payload, payload_size)) &&
+         (!tail_size || WriteAll(tail, tail_size));
+}
+
+}  // namespace cloud_stream
