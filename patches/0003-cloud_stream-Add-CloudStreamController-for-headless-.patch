+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_CLOUD_STREAM_REMOTE_INPUT_H_
+#define CHROME_BROWSER_CLOUD_STREAM_REMOTE_INPUT_H_
+
+#include <string>
+
+#include "chrome/browser/cloud_stream/public/cloud_stream_protocol.h"
+
+namespace aura {
+class WindowTreeHost;
+}  // namespace aura
+
+namespace cloud_stream {
+
+// Converts protocol input messages into ui::Events and feeds them to a
+// window's aura event sink, the same entry point DesktopWindowTreeHostWin
+// uses for native window messages. Views (tab strip, omnibox, menus) and web
+// contents therefore handle them exactly like local input, independent of
+// the single Windows input focus.
+class RemoteInput {
+ public:
+  static void DispatchMouse(aura::WindowTreeHost* host,
+                            const MouseMessage& msg);
+  static void DispatchWheel(aura::WindowTreeHost* host,
+                            const WheelMessage& msg);
+
+  // Key down / up for non-text keys and shortcuts. This does not insert
+  // characters: on Windows the input method reads WM_CHAR from the real
+  // message queue, which a synthesized key down never populates. Printable
+  // text and IME results come through CommitText instead.
+  static void DispatchKey(aura::WindowTreeHost* host, const KeyMessage& msg);
+
+  // Inserts committed text (typed characters or an IME result) through the
+  // focused TextInputClient.
+  static void CommitText(aura::WindowTreeHost* host, const std::u16string& t);
+
+  // Sets or clears the in-progress IME composition.
+  static void SetComposition(aura::WindowTreeHost* host,
+                             const std::u16string& text,
+                             uint32_t cursor);
+};
+
+}  // namespace cloud_stream
+
+#endif  // CHROME_BROWSER_CLOUD_STREAM_REMOTE_INPUT_H_
diff --git a/chrome/browser/cloud_stream/window_stream.cc b/chrome/browser/cloud_stream/window_stream.cc
new file mode 100644
index 00000000..72541d2a
--- /dev/null
+++ b/chrome/browser/cloud_stream/window_stream.cc
@@ -0,0 +1,163 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/cloud_stream/window_stream.h"
+
+#include <windows.h>
+
+#include <utility>
+
+#include "base/logging.h"
+#include "chrome/browser/cloud_stream/pipe_transport.h"
+#include "chrome/browser/cloud_stream/public/cloud_stream_protocol.h"
+#include "components/viz/common/surfaces/video_capture_target.h"
+#include "components/viz/host/host_frame_sink_manager.h"
+#include "media/base/video_types.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/compositor/compositor.h"
+#include "ui/gfx/gpu_memory_buffer_handle.h"
+
+namespace cloud_stream {
+
+WindowStream::WindowStream(uint32_t window_id,
+                           aura::WindowTreeHost* host,
+                           PipeTransport* transport,
+                           HANDLE gateway_process,
+                           base::TimeDelta min_capture_period)
+    : window_id_(window_id),
+      host_(host),
+      transport_(transport),
+      gateway_process_(gateway_process) {
+  host_->AddObserver(this);
+
+  ui::Compositor* compositor = host_->compositor();
+  viz::HostFrameSinkManager* frame_sink_manager =
+      compositor->context_factory()->GetHostFrameSinkManager();
+  capturer_ = frame_sink_manager->CreateVideoCapturer();
+
+  // ARGB with a native handle: the frame stays a D3D11 texture on the GPU
+  // and is delivered as a DXGI NT handle. NV12 is only allowed with mappable
+  // shared images, which would force a CPU-visible copy.
+  capturer_->SetFormat(media::PIXEL_FORMAT_ARGB);
+  capturer_->SetMinCapturePeriod(min_capture_period);
+  capturer_->SetMinSizeChangePeriod(base::TimeDelta());
+  capturer_->SetAutoThrottlingEnabled(false);
+  UpdateResolution();
+  capturer_->ChangeTarget(viz::VideoCaptureTarget(compositor->frame_sink_id()));
+  capturer_->Start(
+      this,
+      viz::mojom::BufferFormatPreference::kPreferSharedImageWithNativeHandle);
+
+  SendBounds();
+}
+
+WindowStream::~WindowStream() {
+  capturer_->StopAndResetConsumer();
+  in_flight_.clear();  // Dropping the remotes releases the buffers.
+  host_->RemoveObserver(this);
+}
+
+void WindowStream::UpdateResolution() {
+  // Capture at the window's native pixel size, no scaling.
+  const gfx::Size size = host_->GetBoundsInPixels().size();
+  if (size.IsEmpty()) {
+    return;
+  }
+  capturer_->SetResolutionConstraints(size, size,
+                                      /*use_fixed_aspect_ratio=*/true);
+}
+
+void WindowStream::SendBounds() {
+  const gfx::Rect bounds = host_->GetBoundsInPixels();
+  WindowBoundsMessage msg{window_id_, bounds.x(), bounds.y(), bounds.width(),
+                          bounds.height()};
+  transport_->Send(MessageType::kWindowBounds, &msg, sizeof(msg));
+}
+
+void WindowStream::OnHostResized(aura::WindowTreeHost* host) {
+  UpdateResolution();
+  SendBounds();
+}
+
+void WindowStream::OnHostMovedInPixels(aura::WindowTreeHost* host) {
+  SendBounds();
+}
+
+void WindowStream::RequestRefreshFrame() {
+  capturer_->RequestRefreshFrame();
+}
+
+void WindowStream::OnFrameCaptured(
+    media::mojom::VideoBufferHandlePtr data,
+    media::mojom::VideoFrameInfoPtr info,
+    const gfx::Rect& content_rect,
+    mojo::PendingRemote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks>
+        callbacks) {
+  mojo::Remote<viz::mojom::FrameSinkVideoConsumerFrameCallbacks> done(
+      std::move(callbacks));
+
+  if (!data->is_gpu_memory_buffer_handle()) {
+    // Software compositing fallback delivers shared memory frames. Not
+    // supported by this transport yet; release the buffer immediately.
+    // TODO(cloud_stream): forward shmem frames for the degraded mode.
+    LOG_FIRST_N(WARNING, 1) << "cloud_stream: non-GPU frame, dropping";
+    return;
+  }
+  const gfx::GpuMemoryBufferHandle& gmb =
+      data->get_gpu_memory_buffer_handle();
+  if (gmb.type != gfx::DXGI_SHARED_HANDLE) {
+    return;
+  }
+  const gfx::DXGIHandle& dxgi = gmb.dxgi_handle();
+  const base::Token& token = dxgi.token().value();
+  const auto token_key = std::make_pair(token.high(), token.low());
+
+  // Duplicate the texture handle into the gateway only the first time we see
+  // this pool texture.
+  HANDLE remote_handle = nullptr;
+  if (!known_tokens_.contains(token_key)) {
+    if (!::DuplicateHandle(::GetCurrentProcess(), dxgi.buffer_handle(),
+                           gateway_process_, &remote_handle, 0, FALSE,
+                           DUPLICATE_SAME_ACCESS)) {
+      PLOG(ERROR) << "cloud_stream: DuplicateHandle failed";
+      return;
+    }
+    known_tokens_[token_key] = true;
+  }
+
+  // TODO(cloud_stream, P6): on devices with D3DSharedFence support the
+  // texture has no keyed mutex and the blit may still be in flight. Verify on
+  // hardware; if frames tear, export the fence alongside the frame.
+
+  const uint64_t seq = next_frame_seq_++;
+  FrameMessage msg{};
+  msg.window_id = window_id_;
+  msg.frame_seq = seq;
+  msg.texture_handle = reinterpret_cast<uint64_t>(remote_handle);
+  msg.texture_token_high = token.high();
+  msg.texture_token_low = token.low();
+  msg.coded_width = info->coded_size.width();
+  msg.coded_height = info->coded_size.height();
+  msg.visible_x = content_rect.x();
+  msg.visible_y = content_rect.y();
+  msg.visible_width = content_rect.width();
+  msg.visible_height = content_rect.height();
+  msg.timestamp_us = info->timestamp.InMicroseconds();
+
+  if (!transport_->Send(MessageType::kFrame, &msg, sizeof(msg))) {
+    return;  // `done` goes out of scope and releases the buffer.
+  }
+  in_flight_.emplace(seq, std::move(done));
+}
+
+void WindowStream::OnFrameDone(uint64_t frame_seq) {
+  auto it = in_flight_.find(frame_seq);
+  if (it == in_flight_.end()) {
+    return;
+  }
+  it->second->Done();
+  in_flight_.erase(it);
+}
+
+}  // namespace cloud_stream
