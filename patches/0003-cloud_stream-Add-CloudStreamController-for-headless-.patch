+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/cloud_stream/cloud_stream_controller.h"
+
+#include <windows.h>
+
+#include <cstring>
+#include <utility>
+
+#include "base/command_line.h"
+#include "base/functional/bind.h"
+#include "base/functional/callback_helpers.h"
+#include "base/logging.h"
+#include "base/strings/string_split.h"
+#include "base/strings/utf_string_conversions.h"
+#include "chrome/browser/cloud_stream/cloud_select_file_dialog.h"
+#include "chrome/browser/cloud_stream/pipe_transport.h"
+#include "chrome/browser/cloud_stream/window_stream.h"
+#include "components/viz/common/frame_sinks/begin_frame_args.h"
+#include "third_party/skia/include/core/SkBitmap.h"
+#include "ui/aura/client/drag_drop_client.h"
+#include "ui/aura/env.h"
+#include "ui/aura/window.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/cursor/cursor.h"
+#include "ui/base/cursor/mojom/cursor_type.mojom-shared.h"
+#include "ui/base/dragdrop/mojom/drag_drop_types.mojom-shared.h"
+#include "ui/base/ui_base_switches.h"
+#include "ui/compositor/compositor.h"
+#include "ui/shell_dialogs/select_file_dialog.h"
+#include "ui/views/widget/widget.h"
+
+namespace cloud_stream {
+
+namespace {
+
+CloudStreamController* g_controller = nullptr;
+
+// Default capture pacing when the gateway does not drive BeginFrames.
+constexpr base::TimeDelta kDefaultCapturePeriod = base::Hertz(60);
+
+template <typename T>
+bool ReadStruct(const std::vector<uint8_t>& payload, T* out) {
+  if (payload.size() < sizeof(T)) {
+    return false;
+  }
+  std::memcpy(out, payload.data(), sizeof(T));
+  return true;
+}
+
+// Reads `length` UTF-16 code units that follow a struct of type T.
+template <typename T>
+std::u16string ReadTail(const std::vector<uint8_t>& payload, uint32_t length) {
+  const size_t bytes = size_t{length} * sizeof(char16_t);
+  if (payload.size() < sizeof(T) + bytes) {
+    return std::u16string();
+  }
+  std::u16string text(length, u'\0');
+  std::memcpy(text.data(), payload.data() + sizeof(T), bytes);
+  return text;
+}
+
+// Drag and drop is disabled in the first version: the native OLE loop is
+// driven by the physical mouse and cannot be fed remotely.
+// TODO(cloud_stream, P5): implement an in-process drag session driven by
+// the remote pointer.
+class NoopDragDropClient : public aura::client::DragDropClient {
+ public:
+  ui::mojom::DragOperation StartDragAndDrop(
+      std::unique_ptr<ui::OSExchangeData> data,
+      aura::Window* root_window,
+      aura::Window* source_window,
+      const gfx::Point& screen_location,
+      int allowed_operations,
+      ui::mojom::DragEventSource source) override {
+    return ui::mojom::DragOperation::kNone;
+  }
+  void DragCancel() override {}
+  bool IsDragDropInProgress() override { return false; }
+  void AddObserver(aura::client::DragDropClientObserver* observer) override {}
+  void RemoveObserver(
+      aura::client::DragDropClientObserver* observer) override {}
+};
+
+// Framed windows (browser, app, DevTools) are kNormal; everything else
+// (menus, bubbles, <select>, tooltips, extension popups) is kPopup.
+WindowKind KindForHost(aura::WindowTreeHost* host) {
+  views::Widget* widget =
+      views::Widget::GetWidgetForNativeWindow(host->window());
+  return widget && widget->non_client_view() ? WindowKind::kNormal
+                                             : WindowKind::kPopup;
+}
+
+}  // namespace
+
+// static
+CloudStreamController* CloudStreamController::Get() {
+  return g_controller;
+}
+
+// static
+std::unique_ptr<CloudStreamController> CloudStreamController::MaybeCreate() {
+  const base::CommandLine* command_line =
+      base::CommandLine::ForCurrentProcess();
+  if (!command_line->HasSwitch(switches::kCloudStreamPipe)) {
+    return nullptr;
+  }
+  auto controller = base::WrapUnique(new CloudStreamController(
+      command_line->GetSwitchValueNative(switches::kCloudStreamPipe)));
+  if (!controller->Start()) {
+    return nullptr;
+  }
+  return controller;
+}
+
+CloudStreamController::CloudStreamController(const std::wstring& pipe_name)
+    : pipe_name_(pipe_name),
+      begin_frame_sequence_(viz::BeginFrameArgs::kStartingFrameNumber) {}
+
+CloudStreamController::~CloudStreamController() {
+  streams_.clear();
+  aura::Env::GetInstance()->RemoveObserver(this);
+  views::CloudStreamHooksWin::Set(nullptr);
+  g_controller = nullptr;
+}
+
+bool CloudStreamController::Start() {
+  transport_ = std::make_unique<PipeTransport>(
+      pipe_name_,
+      base::BindRepeating(&CloudStreamController::OnMessage,
+                          weak_factory_.GetWeakPtr()),
+      base::BindOnce(&CloudStreamController::OnDisconnected,
+                     weak_factory_.GetWeakPtr()));
+  if (!transport_->Start()) {
+    return false;
+  }
+  g_controller = this;
+  // Must happen before the first top-level window is created, so that
+  // DesktopWindowTreeHostWin picks up the hooks in Init().
+  views::CloudStreamHooksWin::Set(this);
+  aura::Env::GetInstance()->AddObserver(this);
+  // Runs after ChromeBrowserMainParts installed ChromeSelectFileDialogFactory
+  // (chrome_browser_main.cc), so this replaces it.
+  ui::SelectFileDialog::SetFactory(
+      std::make_unique<CloudSelectFileDialogFactory>());
+  return true;
+}
+
+// --- Window tracking --------------------------------------------------------
+
+void CloudStreamController::OnHostInitialized(aura::WindowTreeHost* host) {
+  const uint32_t id = next_window_id_++;
+  hosts_[id] = host;
+  if (hello_received_) {
+    AnnounceWindow(id, host);
+    StartStream(id, host);
+  }
+}
+
+void CloudStreamController::OnHostDestroyed(aura::WindowTreeHost* host) {
+  const uint32_t id = IdForHost(host);
+  if (!id) {
+    return;
+  }
+  streams_.erase(id);
+  hosts_.erase(id);
+  if (hello_received_) {
+    WindowMessage msg{};
+    msg.window_id = id;
+    transport_->Send(MessageType::kWindowDestroyed, &msg, sizeof(msg));
+  }
+}
+
+void CloudStreamController::AnnounceWindow(uint32_t id,
+                                           aura::WindowTreeHost* host) {
+  WindowMessage msg{};
+  msg.window_id = id;
+  msg.kind = KindForHost(host);
+  if (views::Widget* widget =
+          views::Widget::GetWidgetForNativeWindow(host->window())) {
+    if (views::Widget* parent = widget->parent()) {
+      if (aura::WindowTreeHost* parent_host =
+              parent->GetNativeWindow()->GetHost()) {
+        msg.parent_window_id = IdForHost(parent_host);
+      }
+    }
+  }
+  const gfx::Rect bounds = host->GetBoundsInPixels();
+  msg.x = bounds.x();
+  msg.y = bounds.y();
+  msg.width = bounds.width();
+  msg.height = bounds.height();
+  transport_->Send(MessageType::kWindowCreated, &msg, sizeof(msg));
+}
+
+void CloudStreamController::StartStream(uint32_t id,
+                                        aura::WindowTreeHost* host) {
+  if (!host->compositor()) {
+    return;
+  }
+  streams_[id] = std::make_unique<WindowStream>(
+      id, host, transport_.get(), gateway_process_.get(),
+      kDefaultCapturePeriod);
+}
+
+aura::WindowTreeHost* CloudStreamController::HostForId(uint32_t id) const {
+  auto it = hosts_.find(id);
+  return it == hosts_.end() ? nullptr : it->second.get();
+}
+
+uint32_t CloudStreamController::IdForHost(aura::WindowTreeHost* host) const {
+  for (const auto& [id, h] : hosts_) {
+    if (h == host) {
+      return id;
+    }
+  }
+  return 0;
+}
+
+// --- views::CloudStreamHooksWin ---------------------------------------------
+
+bool CloudStreamController::UseExternalBeginFrameControl() {
+  return base::CommandLine::ForCurrentProcess()->HasSwitch(
+      switches::kCloudStreamExternalBeginFrame);
+}
+
+void CloudStreamController::OnCursorChanged(aura::WindowTreeHost* host,
+                                            const ui::Cursor& cursor) {
+  if (!hello_received_) {
+    return;
+  }
+  CursorMessage msg{};
+  msg.window_id = IdForHost(host);
+  msg.cursor_type = static_cast<uint32_t>(cursor.type());
+  if (cursor.type() != ui::mojom::CursorType::kCustom) {
+    transport_->Send(MessageType::kCursor, &msg, sizeof(msg));
+    return;
+  }
+  const SkBitmap& bitmap = cursor.custom_bitmap();
+  msg.width = bitmap.width();
+  msg.height = bitmap.height();
+  msg.hotspot_x = cursor.custom_hotspot().x();
+  msg.hotspot_y = cursor.custom_hotspot().y();
+  // Custom cursor bitmaps are N32 (BGRA on Windows).
+  transport_->Send(MessageType::kCursor, &msg, sizeof(msg), bitmap.getPixels(),
+                   static_cast<uint32_t>(bitmap.computeByteSize()));
+}
+
+std::unique_ptr<aura::client::DragDropClient>
+CloudStreamController::CreateDragDropClient(aura::WindowTreeHost* host) {
+  return std::make_unique<NoopDragDropClient>();
+}
+
+// --- Transport --------------------------------------------------------------
+
+void CloudStreamController::OnMessage(MessageType type,
+                                      std::vector<uint8_t> payload) {
+  switch (type) {
+    case MessageType::kHello: {
+      HelloMessage msg;
+      if (ReadStruct(payload, &msg)) {
+        HandleHello(msg);
+      }
+      break;
+    }
+    case MessageType::kBeginFrame: {
+      BeginFrameMessage msg;
+      if (ReadStruct(payload, &msg)) {
+        HandleBeginFrame(msg);
+      }
+      break;
+    }
+    case MessageType::kFrameDone: {
+      FrameDoneMessage msg;
+      if (ReadStruct(payload, &msg)) {
+        HandleFrameDone(msg);
+      }
+      break;
+    }
+    case MessageType::kSetWindowBounds: {
+      WindowBoundsMessage msg;
+      if (ReadStruct(payload, &msg)) {
+        HandleSetWindowBounds(msg);
+      }
+      break;
+    }
+    case MessageType::kFileChosen: {
+      FileChosenMessage msg;
+      if (ReadStruct(payload, &msg)) {
+        HandleFileChosen(msg, ReadTail<FileChosenMessage>(payload, msg.length));
+      }
+      break;
+    }
+    case MessageType::kMouse:
+    case MessageType::kWheel:
+    case MessageType::kKey:
+    case MessageType::kText:
+    case MessageType::kComposition:
+      // TODO(cloud_stream): remote input, see remote_input.h and
+      // docs/architecture.md section 3.6. Not implemented in this patch.
+      break;
+    case MessageType::kClipboardText:
+      // TODO(cloud_stream): bridge to the headless clipboard.
+      break;
+    default:
+      LOG(WARNING) << "cloud_stream: unexpected message "
+                   << static_cast<uint32_t>(type);
+      break;
+  }
+}
+
+void CloudStreamController::OnDisconnected() {
+  LOG(ERROR) << "cloud_stream: gateway disconnected";
+  streams_.clear();
+  hello_received_ = false;
+}
+
+void CloudStreamController::HandleHello(const HelloMessage& msg) {
+  if (msg.protocol_version != kProtocolVersion || hello_received_) {
+    return;
+  }
+  gateway_process_.Set(
+      ::OpenProcess(PROCESS_DUP_HANDLE, FALSE, msg.gateway_pid));
+  if (!gateway_process_.is_valid()) {
+    PLOG(ERROR) << "cloud_stream: cannot open gateway process";
+    return;
+  }
+  hello_received_ = true;
+
+  HelloAckMessage ack{kProtocolVersion, ::GetCurrentProcessId()};
+  transport_->Send(MessageType::kHelloAck, &ack, sizeof(ack));
+
+  // Announce windows created before the gateway connected, parents first
+  // (ids are increasing in creation order).
+  for (const auto& [id, host] : hosts_) {
+    AnnounceWindow(id, host);
+    StartStream(id, host);
+  }
+}
+
+void CloudStreamController::HandleBeginFrame(const BeginFrameMessage& msg) {
+  if (!UseExternalBeginFrameControl()) {
+    return;
+  }
+  const base::TimeTicks frame_time =
+      base::TimeTicks() + base::Microseconds(msg.frame_time_us);
+  const base::TimeDelta interval = base::Microseconds(msg.interval_us);
+  auto issue = [&](aura::WindowTreeHost* host) {
+    if (!host->compositor()) {
+      return;
+    }
+    auto args = viz::BeginFrameArgs::Create(
+        BEGINFRAME_FROM_HERE, viz::BeginFrameArgs::kManualSourceId,
+        begin_frame_sequence_++, frame_time, frame_time + interval, interval,
+        viz::BeginFrameArgs::NORMAL);
+    host->compositor()->IssueExternalBeginFrame(args, base::DoNothing());
+  };
+  if (msg.window_id == 0) {
+    for (const auto& [id, host] : hosts_) {
+      issue(host);
+    }
+  } else if (aura::WindowTreeHost* host = HostForId(msg.window_id)) {
+    issue(host);
+  }
+}
+
+void CloudStreamController::HandleFrameDone(const FrameDoneMessage& msg) {
+  auto it = streams_.find(msg.window_id);
+  if (it != streams_.end()) {
+    it->second->OnFrameDone(msg.frame_seq);
+  }
+}
+
+void CloudStreamController::HandleSetWindowBounds(
+    const WindowBoundsMessage& msg) {
+  if (aura::WindowTreeHost* host = HostForId(msg.window_id)) {
+    host->SetBoundsInPixels(
+        gfx::Rect(msg.x, msg.y, msg.width, msg.height));
+  }
+}
+
+// --- File chooser -----------------------------------------------------------
+
+void CloudStreamController::RequestFileChooser(gfx::NativeWindow owning_window,
+                                               FileChooserMode mode,
+                                               const std::u16string& title,
+                                               FileChooserCallback callback) {
+  if (!hello_received_) {
+    std::move(callback).Run(/*canceled=*/true, {});
+    return;
+  }
+  const uint32_t request_id = next_file_request_id_++;
+  file_requests_[request_id] = std::move(callback);
+
+  FileChooserRequestMessage msg{};
+  msg.request_id = request_id;
+  msg.window_id = owning_window && owning_window->GetHost()
+                      ? IdForHost(owning_window->GetHost())
+                      : 0;
+  msg.mode = mode;
+  msg.title_length = static_cast<uint32_t>(title.size());
+  transport_->Send(MessageType::kFileChooserRequest, &msg, sizeof(msg),
+                   title.data(),
+                   static_cast<uint32_t>(title.size() * sizeof(char16_t)));
+}
+
+void CloudStreamController::HandleFileChosen(const FileChosenMessage& msg,
+                                             const std::u16string& paths) {
+  auto it = file_requests_.find(msg.request_id);
+  if (it == file_requests_.end()) {
+    return;
+  }
+  FileChooserCallback callback = std::move(it->second);
+  file_requests_.erase(it);
+
+  std::vector<base::FilePath> files;
+  if (!msg.canceled) {
+    for (const auto& path :
+         base::SplitString(paths, std::u16string(1, u'\0'),
+                           base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+      files.emplace_back(base::AsWStringView(path));
+    }
+  }
+  std::move(callback).Run(msg.canceled != 0, std::move(files));
+}
+
+}  // namespace cloud_stream
