From 5de0795cd25fa906ddb1c8fc0e1c3fc92d0bda28 Mon Sep 17 00:00:00 2001
From: FlysoftBeta <xwnunjyau@outlook.com>
Date: Sun, 18 Oct 2026 03:15:16 +0000
Subject: [PATCH 2/4] [cloud_stream] Add CloudStreamHooksWin to
 DesktopWindowTreeHostWin

Lets the embedder enable external BeginFrame control, observe cursor
changes and replace the OLE drag and drop client. No behavior change
unless hooks are registered.
---
 ui/views/BUILD.gn                             |  2 +
 .../desktop_aura/cloud_stream_hooks_win.cc    | 23 ++++++++
 .../desktop_aura/cloud_stream_hooks_win.h     | 57 +++++++++++++++++++
 .../desktop_window_tree_host_win.cc           | 17 +++++-
 4 files changed, 98 insertions(+), 1 deletion(-)
 create mode 100644 ui/views/widget/desktop_aura/cloud_stream_hooks_win.cc
 create mode 100644 ui/views/widget/desktop_aura/cloud_stream_hooks_win.h

diff --git a/ui/views/BUILD.gn b/ui/views/BUILD.gn
index c0d1b5ed..c2617d75 100644
--- a/ui/views/BUILD.gn
+++ b/ui/views/BUILD.gn
@@ -946,10 +946,12 @@ component("views") {
       ]
       if (is_win) {
         public += [
+          "widget/desktop_aura/cloud_stream_hooks_win.h",
           "widget/desktop_aura/desktop_drag_drop_client_win.h",
           "widget/desktop_aura/desktop_window_tree_host_win.h",
         ]
         sources += [
+          "widget/desktop_aura/cloud_stream_hooks_win.cc",
           "widget/desktop_aura/desktop_drag_drop_client_win.cc",
           "widget/desktop_aura/desktop_drop_target_win.cc",
           "widget/desktop_aura/desktop_native_cursor_manager_win.cc",
diff --git a/ui/views/widget/desktop_aura/cloud_stream_hooks_win.cc b/ui/views/widget/desktop_aura/cloud_stream_hooks_win.cc
new file mode 100644
index 00000000..a2ccbd09
--- /dev/null
+++ b/ui/views/widget/desktop_aura/cloud_stream_hooks_win.cc
@@ -0,0 +1,23 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "ui/views/widget/desktop_aura/cloud_stream_hooks_win.h"
+
+namespace views {
+
+namespace {
+CloudStreamHooksWin* g_hooks = nullptr;
+}  // namespace
+
+// static
+void CloudStreamHooksWin::Set(CloudStreamHooksWin* hooks) {
+  g_hooks = hooks;
+}
+
+// static
+CloudStreamHooksWin* CloudStreamHooksWin::Get() {
