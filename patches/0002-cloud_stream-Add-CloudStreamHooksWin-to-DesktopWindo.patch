diff --git a/ui/views/widget/desktop_aura/cloud_stream_hooks_win.h b/ui/views/widget/desktop_aura/cloud_stream_hooks_win.h
new file mode 100644
index 00000000..e85fefa1
--- /dev/null
+++ b/ui/views/widget/desktop_aura/cloud_stream_hooks_win.h
@@ -0,0 +1,57 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef UI_VIEWS_WIDGET_DESKTOP_AURA_CLOUD_STREAM_HOOKS_WIN_H_
+#define UI_VIEWS_WIDGET_DESKTOP_AURA_CLOUD_STREAM_HOOKS_WIN_H_
+
+#include <memory>
+
+#include "ui/views/views_export.h"
+
+namespace aura {
+class WindowTreeHost;
+namespace client {
+class DragDropClient;
+}  // namespace client
+}  // namespace aura
+
+namespace ui {
+class Cursor;
+}  // namespace ui
+
+namespace views {
+
+// Hooks used by DesktopWindowTreeHostWin when the browser runs in cloud
+// streaming mode (--cloud-stream-pipe). Views cannot depend on //chrome, so
+// the embedder implements this interface and registers it with Set().
+// When no hooks are registered, DesktopWindowTreeHostWin behaves as usual.
+class VIEWS_EXPORT CloudStreamHooksWin {
+ public:
+  virtual ~CloudStreamHooksWin() = default;
+
+  // Registers the process-wide hooks. Pass nullptr to unregister. Must be
+  // called on the UI thread, before any top-level window is created.
+  static void Set(CloudStreamHooksWin* hooks);
+  static CloudStreamHooksWin* Get();
+
+  // Whether new compositors should be created with external BeginFrame
+  // control. The embedder is then responsible for issuing BeginFrames.
+  virtual bool UseExternalBeginFrameControl() = 0;
+
+  // Called whenever a host changes its cursor, before the native cursor is
+  // set. The embedder forwards it to the remote client, which draws the
+  // cursor locally.
+  virtual void OnCursorChanged(aura::WindowTreeHost* host,
+                               const ui::Cursor& cursor) = 0;
+
+  // Returns the drag and drop client to use for `host`. The native OLE client
+  // runs a modal loop driven by the physical mouse, which remote input cannot
+  // drive, so the embedder must provide its own implementation.
+  virtual std::unique_ptr<aura::client::DragDropClient> CreateDragDropClient(
+      aura::WindowTreeHost* host) = 0;
+};
+
+}  // namespace views
+
+#endif  // UI_VIEWS_WIDGET_DESKTOP_AURA_CLOUD_STREAM_HOOKS_WIN_H_
diff --git a/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc b/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
index 228f4a8f..92f24385 100644
--- a/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
+++ b/ui/views/widget/desktop_aura/desktop_window_tree_host_win.cc
@@ -63,6 +63,7 @@
 #include "ui/views/corewm/tooltip_aura.h"
 #include "ui/views/views_features.h"
 #include "ui/views/views_switches.h"
+#include "ui/views/widget/desktop_aura/cloud_stream_hooks_win.h"
 #include "ui/views/widget/desktop_aura/desktop_drag_drop_client_win.h"
 #include "ui/views/widget/desktop_aura/desktop_native_cursor_manager.h"
 #include "ui/views/widget/desktop_aura/desktop_native_cursor_manager_win.h"
@@ -300,7 +301,12 @@ void DesktopWindowTreeHostWin::Init(const Widget::InitParams& params) {
 
   UpdateBackdropColorMode();
 
-  CreateCompositor(params.force_software_compositing);
+  // In cloud streaming mode the embedder may drive BeginFrames itself.
+  CloudStreamHooksWin* cloud_stream_hooks = CloudStreamHooksWin::Get();
+  CreateCompositor(params.force_software_compositing,
+                   /*use_external_begin_frame_control=*/
+                   cloud_stream_hooks &&
+                       cloud_stream_hooks->UseExternalBeginFrameControl());
   OnAcceleratedWidgetAvailable();
   InitHost();
   window()->Show();
@@ -351,6 +357,11 @@ std::unique_ptr<corewm::Tooltip> DesktopWindowTreeHostWin::CreateTooltip() {
 
 std::unique_ptr<aura::client::DragDropClient>
 DesktopWindowTreeHostWin::CreateDragDropClient() {
+  // The OLE drag loop is driven by the physical mouse, so in cloud streaming
+  // mode the embedder supplies a client that remote input can drive.
+  if (CloudStreamHooksWin* hooks = CloudStreamHooksWin::Get()) {
+    return hooks->CreateDragDropClient(this);
+  }
   auto res =
       std::make_unique<DesktopDragDropClientWin>(window(), GetHWND(), this);
   drag_drop_client_ = res->GetWeakPtr();
@@ -901,6 +912,10 @@ void DesktopWindowTreeHostWin::SetCursorNative(gfx::NativeCursor cursor) {
   TRACE_EVENT1("ui,input", "DesktopWindowTreeHostWin::SetCursorNative",
                "cursor", cursor.type());
 
+  if (CloudStreamHooksWin* hooks = CloudStreamHooksWin::Get()) {
+    hooks->OnCursorChanged(this, cursor);
+  }
+
   message_handler_->SetCursor(
       ui::WinCursor::FromPlatformCursor(cursor.platform()));
 }
