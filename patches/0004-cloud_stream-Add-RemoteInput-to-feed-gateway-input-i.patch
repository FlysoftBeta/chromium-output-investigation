--- /dev/null
+++ b/chrome/browser/cloud_stream/remote_input.cc
@@ -0,0 +1,189 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/cloud_stream/remote_input.h"
+
+#include <windows.h>
+
+#include <algorithm>
+
+#include "base/time/time.h"
+#include "ui/aura/window_tree_host.h"
+#include "ui/base/ime/composition_text.h"
+#include "ui/base/ime/input_method.h"
+#include "ui/base/ime/text_input_client.h"
+#include "ui/events/event.h"
+#include "ui/events/event_constants.h"
+#include "ui/events/keycodes/dom/dom_code.h"
+#include "ui/events/keycodes/keyboard_code_conversion_win.h"
+#include "ui/events/keycodes/keyboard_codes.h"
+#include "ui/gfx/geometry/point_f.h"
+#include "ui/gfx/geometry/vector2d.h"
+#include "ui/gfx/range/range.h"
+
+namespace cloud_stream {
+
+namespace {
+
+// Keyboard modifiers share their bit values with ui::EventFlags, mouse
+// buttons do not (EF_LEFT_MOUSE_BUTTON is 1 << 11, not 1 << 6).
+constexpr uint32_t kKeyboardModifierMask = kShift | kControl | kAlt | kCommand;
+
+int ToEventFlags(uint32_t modifiers) {
+  int flags = static_cast<int>(modifiers & kKeyboardModifierMask);
+  if (modifiers & kLeftButton) {
+    flags |= ui::EF_LEFT_MOUSE_BUTTON;
+  }
+  if (modifiers & kMiddleButton) {
+    flags |= ui::EF_MIDDLE_MOUSE_BUTTON;
+  }
+  if (modifiers & kRightButton) {
+    flags |= ui::EF_RIGHT_MOUSE_BUTTON;
+  }
+  return flags;
+}
+
+int ToChangedButtonFlags(uint32_t changed_button) {
+  switch (changed_button) {
+    case kLeftButton:
+      return ui::EF_LEFT_MOUSE_BUTTON;
+    case kMiddleButton:
+      return ui::EF_MIDDLE_MOUSE_BUTTON;
+    case kRightButton:
+      return ui::EF_RIGHT_MOUSE_BUTTON;
+    default:
+      return ui::EF_NONE;
+  }
+}
+
+constexpr int kAnyButtonFlags = ui::EF_LEFT_MOUSE_BUTTON |
+                                ui::EF_MIDDLE_MOUSE_BUTTON |
+                                ui::EF_RIGHT_MOUSE_BUTTON;
+
+}  // namespace
+
+// static
+void RemoteInput::DispatchMouse(aura::WindowTreeHost* host,
+                                const MouseMessage& msg) {
+  if (!host) {
+    return;
+  }
+  const int flags = ToEventFlags(msg.modifiers);
+  const int changed_button_flags = ToChangedButtonFlags(msg.changed_button);
+  ui::EventType type;
+  switch (msg.action) {
+    case MouseAction::kMove:
+      type = (flags & kAnyButtonFlags) ? ui::EventType::kMouseDragged
+                                       : ui::EventType::kMouseMoved;
+      break;
+    case MouseAction::kDown:
+      type = ui::EventType::kMousePressed;
+      break;
+    case MouseAction::kUp:
+      type = ui::EventType::kMouseReleased;
+      break;
+    case MouseAction::kEnter:
+      type = ui::EventType::kMouseEntered;
+      break;
+    case MouseAction::kLeave:
+      type = ui::EventType::kMouseExited;
+      break;
+    default:
+      return;
+  }
+  // Protocol coordinates are window pixels, which are host pixels for a
+  // top-level host, so location and root_location are the same.
+  const gfx::PointF location(msg.x, msg.y);
+  ui::MouseEvent event(type, location, location, base::TimeTicks::Now(), flags,
+                       changed_button_flags);
+  if (type == ui::EventType::kMousePressed) {
+    event.SetClickCount(
+        static_cast<int>(std::max<uint32_t>(msg.click_count, 1)));
+  }
+  // Same entry point as DesktopWindowTreeHostWin::HandleMouseEvent().
+  host->SendEventToSink(&event);
+}
+
+// static
+void RemoteInput::DispatchWheel(aura::WindowTreeHost* host,
+                                const WheelMessage& msg) {
+  if (!host) {
+    return;
+  }
+  const gfx::PointF location(msg.x, msg.y);
+  // The deltas are in WM_MOUSEWHEEL units (120 per notch), which is what
+  // ui::MouseWheelEvent offsets hold for events created from native
+  // Windows messages.
+  ui::MouseWheelEvent event(gfx::Vector2d(msg.delta_x, msg.delta_y), location,
+                            location, base::TimeTicks::Now(),
+                            ToEventFlags(msg.modifiers), ui::EF_NONE);
+  host->SendEventToSink(&event);
+}
+
+// static
+void RemoteInput::DispatchKey(aura::WindowTreeHost* host,
+                              const KeyMessage& msg) {
+  if (!host) {
+    return;
+  }
+  int flags = ToEventFlags(msg.modifiers);
+  if ((msg.scan_code & 0xFF00) == 0xE000) {
+    flags |= ui::EF_IS_EXTENDED_KEY;
+  }
+  const ui::KeyboardCode key_code =
+      ui::KeyboardCodeForWindowsKeyCode(static_cast<WORD>(msg.windows_vk));
+  const ui::DomCode dom_code =
+      ui::CodeForWindowsScanCode(static_cast<WORD>(msg.scan_code));
+  // The DomKey is left unset and derived lazily from the DomCode.
+  ui::KeyEvent event(
+      msg.pressed ? ui::EventType::kKeyPressed : ui::EventType::kKeyReleased,
+      key_code, dom_code, flags, base::TimeTicks::Now());
+  host->SendEventToSink(&event);
+}
+
+// static
+void RemoteInput::CommitText(aura::WindowTreeHost* host,
+                             const std::u16string& text) {
+  if (!host || text.empty()) {
+    return;
+  }
+  ui::InputMethod* input_method = host->GetInputMethod();
+  if (!input_method) {
+    return;
+  }
+  if (ui::TextInputClient* client = input_method->GetTextInputClient()) {
+    client->InsertText(
+        text,
+        ui::TextInputClient::InsertTextCursorBehavior::kMoveCursorAfterText);
+  }
+}
+
+// static
+void RemoteInput::SetComposition(aura::WindowTreeHost* host,
+                                 const std::u16string& text,
+                                 uint32_t cursor) {
+  if (!host) {
+    return;
+  }
+  ui::InputMethod* input_method = host->GetInputMethod();
+  if (!input_method) {
+    return;
+  }
+  ui::TextInputClient* client = input_method->GetTextInputClient();
+  if (!client) {
+    return;
+  }
+  if (text.empty()) {
+    client->ClearCompositionText();
+    return;
+  }
+  ui::CompositionText composition;
+  composition.text = text;
+  const size_t caret = std::min<size_t>(cursor, text.size());
+  composition.selection =
+      gfx::Range(static_cast<uint32_t>(caret), static_cast<uint32_t>(caret));
+  client->SetCompositionText(composition);
+}
+
+}  // namespace cloud_stream
